rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ── Helper functions ──────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }
    
    function isHead() {
      return isAuthenticated() && getUserData().role == 'head';
    }
    
    function isActiveUser() {
      return isAuthenticated() && getUserData().status == 'active';
    }
    
    // ── Users collection (KHÓA BẢO MẬT) ──────────────────────────────
    match /users/{userId} {
      // Ai cũng có thể đọc profile riêng; Admin đọc tất cả; Trưởng khoa đọc nhân viên khoa mình
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin() || 
        (isHead() && resource.data.department == getUserData().department)
      );
      // Đăng ký: tạo doc cho chính mình
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Sửa: admin, chính mình, hoặc Trưởng khoa sửa nhân viên cùng khoa (không được đổi role thành admin/head)
      allow update: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin() || 
        (
          isHead() && 
          resource.data.department == getUserData().department && 
          resource.data.role == 'staff' && 
          request.resource.data.role == 'staff'
        )
      );
      // Xóa: chỉ admin
      allow delete: if isAdmin();
    }
    
    // ── Surgery data (GIỮ MỞ TẠM — Phase Guest-First) ────────────────
    // Sẽ đóng khi admin bật "Bắt buộc đăng nhập"
    
    // Collection group query cho processed_records
    match /{document=**}/processed_records/{recordId} {
      allow read, write: if true;
    }
    
    // Reports & nested processed_records
    match /reports/{reportId} {
      allow read, write: if true;

      match /processed_records/{recordId} {
        allow read, write: if true;
      }
    }

    // Surgery profiles
    match /surgery_profiles/{profileId} {
      allow read, write: if true;
    }

    // Duty schedules
    match /duty_schedules/{dateKey} {
      allow read, write: if true;
    }
  }
}
